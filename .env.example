# Copy this file to .env and edit it. NEVER commit .env to GitHub.

# Random secret used by Flask for sessions and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Set to 1 only on your own machine while developing. Keep 0 otherwise.
FLASK_DEBUG=0

# Optional: Google Gemini API key for the summarizer. Leave empty to disable it.
GEMINI_API_KEY=
# Model name is configurable because Google renames models over time.
# Check the current list in Google's Gemini API docs.
GEMINI_MODEL=gemini-3.8-flash

# Optional: folder holding the LIAR files (train.tsv, valid.tsv, test.tsv)
# LIAR_DIR=data/raw/liar

# six_class keeps the original six LIAR labels (default).
# grouped_two_class is an explicit, coarser grouping (see config.py).
LABEL_MODE=six_class
